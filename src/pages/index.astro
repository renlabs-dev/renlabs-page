---
import { Image } from "astro:assets";
import fish from "../assets/fish.svg";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="w-[18em] h-[18em] md:w-[26em] md:h-[26em] mx-auto">
    <Image
      alt="School of fish"
      src={fish}
      loading="eager"
      class="w-full h-full border border-white"
    />
  </div>
  <nav
    class="mt-6 grid grid-cols-2 gap-[1.618em] text-base md:text-xl font-bold"
  >
    <a href="/about" class="justify-self-end hover:underline">ABOUT</a>
    <a href="/email" class="justify-self-start hover:underline">EMAIL</a>
  </nav>
</Layout>
