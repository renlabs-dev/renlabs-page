---
const { subtitle = false } = Astro.props;
---

<div class="text-center mb-4">
  <h1 class="text-4xl font-bold">RENLABS</h1>
  {subtitle && <h3 class="subtitle">order from chaos</h3>}
</div>

<style>
  .subtitle {
    font-family: "Julius Sans One", sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
